FIRMS_MAP_KEY=replace_with_your_firms_map_key
# Optional: AI explanations with Google Gemini (key from https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: e-mail alerts (in-app and webhook alerts work without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
DATA_DIR=./data
FRONTEND_ORIGIN=http://localhost:5173
